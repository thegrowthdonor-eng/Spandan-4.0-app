{
  "name": "spandan-4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "qa:seed": "node --env-file=.env.qa.local --import tsx scripts/seed-qa.ts",
    "qa:events": "node --env-file=.env.qa.local --import tsx scripts/sync-qa-events.ts",
    "qa:requests": "node --env-file=.env.qa.local --import tsx scripts/sync-qa-event-requests.ts",
    "qa:reset": "node --env-file=.env.qa.local --import tsx scripts/seed-qa.ts",
    "qa:verify": "node --env-file=.env.qa.local --import tsx scripts/verify-qa.ts",
    "dev:qa": "node scripts/run-qa-next.mjs dev",
    "build:qa": "node scripts/run-qa-next.mjs build"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "16.4.5",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "3.6.4",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
