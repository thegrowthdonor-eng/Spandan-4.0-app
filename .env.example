# Server only. Never expose the service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_IDENTITY_PEPPER=
# Required only until the first owner account and festival edition are created.
# Keep this long, random and secret. Remove it from Vercel after setup is complete.
INITIAL_SETUP_CODE=
# Browser push notification keys. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
